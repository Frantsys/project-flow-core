# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# Vercel › Project › Settings › Environment Variables (produção).

# MongoDB Atlas › Database › Connect › Drivers (a integração da Vercel preenche sozinha).
MONGODB_URI="mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Banco de cada ambiente: produção usa o padrão "project-flow" (não defina lá);
# desenvolvimento usa "project-flow-dev" e os previews da Vercel, "project-flow-preview".
MONGODB_DB="project-flow-dev"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
NEXTAUTH_SECRET=""

# Local: http://localhost:3000 · Produção: o domínio final, ex. https://project-flow.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub › Settings › Developer settings › OAuth Apps
GITHUB_ID=""
GITHUB_SECRET=""

# E-mails (confirmação de e-mail e redefinição de senha): resend.com › API Keys.
# Sem chave, em desenvolvimento o e-mail aparece no terminal; em produção é obrigatória.
RESEND_API_KEY=""
# Remetente; precisa de um domínio verificado na Resend. Sem domínio, a Resend só entrega
# para o e-mail da própria conta usando "Project Flow <onboarding@resend.dev>".
EMAIL_FROM=""

# IA na tarefa (resumo e sugestão de subtarefas). Opcional: sem nenhuma chave, os botões de IA não
# aparecem. Com a da Anthropic usa o Claude Haiku 5.5 (console.anthropic.com › API Keys); sem ela e
# com a do Google, o Gemini 3.5 Flash-Lite (aistudio.google.com › Get API key). Custo por uso, centavos.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Demonstração pública ("Ver demonstração" na página inicial, só leitura). Crie os dados com
# `npm run seed -- --public-demo` e aponte para a conta criada. Sem a variável, o botão não entra.
DEMO_USER_EMAIL="demo@demo.projectflow.dev"

# Só desenvolvimento: senha da conta demo@demo.projectflow.dev criada por `npm run seed`
SEED_PASSWORD=""
