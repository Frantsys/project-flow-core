# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# Vercel › Project › Settings › Environment Variables (produção).

# MongoDB Atlas › Database › Connect › Drivers (a integração da Vercel preenche sozinha).
MONGODB_URI="mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Banco de cada ambiente: produção usa o padrão "project-flow" (não defina lá);
# desenvolvimento usa "project-flow-dev" e os previews da Vercel, "project-flow-preview".
MONGODB_DB="project-flow-dev"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
NEXTAUTH_SECRET=""

# Local: http://localhost:3000 · Produção: o domínio final, ex. https://project-flow.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub › Settings › Developer settings › OAuth Apps
GITHUB_ID=""
GITHUB_SECRET=""

# Só desenvolvimento: senha da conta demo@demo.projectflow.dev criada por `npm run seed`
SEED_PASSWORD=""
